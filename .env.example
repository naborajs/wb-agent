# ==============================================================================
# WB-AGENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-super-secret-hex-token-in-production
API_V1_STR=/api/v1
PROJECT_NAME="WB-Agent Platform"

# Primary Database (PostgreSQL with pgvector)
# For local dev / testing fallback: sqlite+aiosqlite:///./wb_agent.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wb_agent
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/wb_agent
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Business / Tenant Info
DEFAULT_ORG_ID=org_default_tea
DEFAULT_ORG_NAME="North Bengal Tea Co."

# Primary Business Owner Escalation Channel
# Format must be E.164 without spaces or punctuation
OWNER_WHATSAPP_NUMBER=+918900653250
OWNER_NOTIFICATION_ENABLED=true
OWNER_VERBOSE_MODE=false

# LLM Providers & NVIDIA NIM Multi-Model Intelligence Layer
NVIDIA_NIM_API_KEY_PRIMARY=your_nvidia_nim_primary_api_key
NVIDIA_NIM_API_KEY_FALLBACK=your_nvidia_nim_fallback_api_key
NVIDIA_API_KEY=your_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,openai/gpt-oss-20b
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
LLM_PROVIDER=nvidia
LLM_FALLBACK_PROVIDER=simulator
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT=30
AI_REQUEST_TIMEOUT=30
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
ENABLE_MINIMAX_M3=false
GEMINI_API_KEY=your_gemini_api_key

# WhatsApp Configuration
# Providers: simulator, development, meta_cloud
WHATSAPP_PROVIDER=simulator
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-meta-waba-id
WHATSAPP_ACCESS_TOKEN=your-meta-permanent-access-token
WHATSAPP_VERIFY_TOKEN=your-webhook-verification-token
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_SECRET=your-meta-app-secret-for-hmac

# Lead Sources & External Integrations
APIFY_TOKEN=apify_api_token_here
APIFY_DEFAULT_ACTOR_ID=your-actor-id
APIFY_DATASET_RETRIEVAL_TIMEOUT=60

# Worker & Concurrency Controls
WORKER_COUNT=2
MAX_AGENT_CONCURRENCY=10
CONVERSATION_LOCK_TIMEOUT_SECONDS=60
MESSAGE_DEBOUNCE_WINDOW_SECONDS=2.5
JOB_POLL_INTERVAL_SECONDS=1.0

# Autonomous Follow-up Engine
FOLLOWUP_ENGINE_ENABLED=true
FOLLOWUP_CHECK_INTERVAL_SECONDS=60
FOLLOWUP_DEFAULT_MAX_ATTEMPTS=3
FOLLOWUP_DAY_0_MINUTES=120
FOLLOWUP_DAY_1_HOURS=24
FOLLOWUP_DAY_3_HOURS=72

# URLs & Network Endpoints
API_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Storage Locations
STORAGE_BASE_PATH=./storage
UPLOAD_MAX_BYTES=10485760
